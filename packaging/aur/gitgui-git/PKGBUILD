# Maintainer: Anton Langstein <anton.langstein@gmail.com>
pkgname=gitgui-git
_pkgname=gitgui
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc="Lightweight Git GUI in the style of Fork (Qt/PySide6)"
arch=('any')
url="https://github.com/AntonLangstein/git_gui"
license=('MIT')
depends=('git' 'python' 'pyside6')
optdepends=('python-pygments: syntax highlighting in diffs')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # Version aus pyproject.toml + Anzahl Commits + Hash, z.B. 0.2.0.r14.g5ae6cb3
  printf "%s.r%s.g%s" \
    "$(python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pkgname"
  # GUI-Tests laufen ohne Bildschirm; Einstellungen und Git-Konfiguration isolieren die Tests selbst
  QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -t .
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/git_gui.desktop "$pkgdir/usr/share/applications/git_gui.desktop"
  install -Dm644 gitgui/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/gitgui.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
